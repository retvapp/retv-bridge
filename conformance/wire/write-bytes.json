{
  "profiles": ["bridge", "helper"],
  "description": "writeBytes assembles a binary file from strict base64 chunks sent in order (offset 0 starts an upload) and pushes it once, after the last chunk, to /sdcard/ReTV/... or exactly /data/local/tmp/retv-home.apk; at most 32 MiB. A chunk rejected by its own checks (unknown-serial, path-not-allowed, bad base64, bad offset/total types, empty data, total over the cap) leaves the upload as it was; a well-formed chunk that does not continue it (other path or total, wrong offset, past total) drops it.",
  "adb": {"devices": {"$tvSerial": {"model": "MiTV-AYFR0"}}},
  "steps": [
    {"open": {"origin": "http://127.0.0.1:5180", "host": "$host"}, "expectStatus": 101},
    {"send": {"id": 1, "token": "$token", "type": "connect", "ip": "$tvIp"}, "expect": {"id": 1, "ok": true, "result": {"serial": "$tvSerial", "model": "MiTV-AYFR0"}}},
    {"send": {"id": 2, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/data/local/tmp/retv-home.apk", "offset": 0, "total": 12, "data": "YWJjZA=="}, "expect": {"id": 2, "ok": true, "result": {"received": 4, "done": false}}},
    {"expectAdb": {"pushed": {}}},
    {"send": {"id": 3, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/data/local/tmp/retv-home.apk", "offset": 4, "total": 12, "data": "ZWZnaA=="}, "expect": {"id": 3, "ok": true, "result": {"received": 8, "done": false}}},
    {"send": {"id": 4, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/data/local/tmp/retv-home.apk", "offset": 8, "total": 12, "data": "aWprbA=="}, "expect": {"id": 4, "ok": true, "result": {"received": 12, "done": true}}},
    {"expectAdb": {"pushed": {"/data/local/tmp/retv-home.apk": "sha256:d682ed4ca4d989c134ec94f1551e1ec580dd6d5a6ecde9f3d35e6e4a717fbde4"}}},
    {"send": {"id": 5, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/data/local/tmp/other.apk", "offset": 0, "total": 1, "data": "eA=="}, "expect": {"id": 5, "ok": false, "error": "path-not-allowed"}},
    {"send": {"id": 6, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/data/local/tmp/retv-home.apk/../x", "offset": 0, "total": 1, "data": "eA=="}, "expect": {"id": 6, "ok": false, "error": "path-not-allowed"}},
    {"send": {"id": 7, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/system/app/x.apk", "offset": 0, "total": 1, "data": "eA=="}, "expect": {"id": 7, "ok": false, "error": "path-not-allowed"}},
    {"send": {"id": 8, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/sdcard/ReTV/../x", "offset": 0, "total": 1, "data": "eA=="}, "expect": {"id": 8, "ok": false, "error": "path-not-allowed"}},
    {"send": {"id": 9, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/sdcard/ReTV/a.bin", "offset": 0, "total": 1, "data": "eA=="}, "expect": {"id": 9, "ok": true, "result": {"received": 1, "done": true}}},
    {"send": {"id": 10, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/data/local/tmp/retv-home.apk", "offset": 0, "total": 4, "data": "not base64!"}, "expect": {"id": 10, "ok": false, "error": "bad-request"}},
    {"send": {"id": 11, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/data/local/tmp/retv-home.apk", "offset": 0, "total": 4, "data": "YWJj ZA=="}, "expect": {"id": 11, "ok": false, "error": "bad-request"}},
    {"send": {"id": 12, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/data/local/tmp/retv-home.apk", "offset": 0, "total": 4, "data": ""}, "expect": {"id": 12, "ok": false, "error": "bad-request"}},
    {"send": {"id": 13, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/data/local/tmp/retv-home.apk", "offset": 0, "total": 67108864, "data": "YWJjZA=="}, "expect": {"id": 13, "ok": false, "error": "bad-request"}},
    {"send": {"id": 14, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/data/local/tmp/retv-home.apk", "offset": 0, "total": 33554433, "data": "YWJjZA=="}, "expect": {"id": 14, "ok": false, "error": "bad-request"}},
    {"send": {"id": 15, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/data/local/tmp/retv-home.apk", "offset": 0, "total": 33554432, "data": "YWJjZA=="}, "expect": {"id": 15, "ok": true, "result": {"received": 4, "done": false}}},

      "/sdcard/ReTV/a.bin": "sha256:2d711642b726b04401627ca9fbac32f5c8530fb1903cc4db02258717921a4881"
    }}},
    {"send": {"id": 20, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/data/local/tmp/retv-home.apk", "offset": 0, "total": 8, "data": "YWJjZA=="}, "expect": {"id": 20, "ok": true, "result": {"received": 4, "done": false}}},
    {"send": {"id": 21, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/sdcard/ReTV/a.bin", "offset": 4, "total": 8, "data": "YWJjZA=="}, "expect": {"id": 21, "ok": false, "error": "bad-request"}},
    {"send": {"id": 107, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/data/local/tmp/retv-home.apk", "offset": 4, "total": 8, "data": "ZWZnaA=="}, "expect": {"id": 107, "ok": false, "error": "bad-request"}},
    {"send": {"id": 22, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/data/local/tmp/retv-home.apk", "total": 4, "data": "YWJjZA=="}, "expect": {"id": 22, "ok": false, "error": "bad-request"}},
    {"send": {"id": 23, "token": "$token", "type": "writeBytes", "serial": "192.168.1.9:5555", "path": "/system/x", "offset": 0, "total": 4, "data": "YWJjZA=="}, "expect": {"id": 23, "ok": false, "error": "unknown-serial"}},
    {"expectAdb": {"pushed": {
      "/data/local/tmp/retv-home.apk": "sha256:9c56cc51b374c3ba189210d5b6d4bf57790d351c96c47c02190ecf1e430635ab",

{
  "profiles": ["helper"],
  "description": "Helper profile: adbStart opens the TV's own adb. method must be classic or wireless (bad-request); wireless needs our key paired first (pairing-needed). Classic connects to 127.0.0.1:5555 once the person allows the RSA dialog.",
  "adb": {
    "devices": {"self": {"model": "MiTV-AYFR0"}},
    "helper": {"sdk": 30, "release": "11", "classicPort": true, "rsa": "allow", "pairingService": true, "wirelessConnect": true, "wirelessPaired": false}
  },
  "steps": [
    {"send": {"id": 1, "type": "adbStart"}, "expect": {"id": 1, "ok": false, "error": "bad-request"}},
    {"send": {"id": 2, "type": "adbStart", "method": "usb"}, "expect": {"id": 2, "ok": false, "error": "bad-request"}},
    {"send": {"id": 3, "type": "adbStart", "method": 1}, "expect": {"id": 3, "ok": false, "error": "bad-request"}},
    {"send": {"id": 4, "type": "adbStart", "method": "wireless"}, "expect": {"id": 4, "ok": false, "error": "pairing-needed"}},
    {"send": {"id": 5, "type": "helperInfo"}, "expect": {"id": 5, "ok": true, "result": {"sdk": 30, "release": "11", "model": "MiTV-AYFR0", "classicPort": true, "adb": "none", "method": null}}},
    {"send": {"id": 6, "type": "adbStart", "method": "classic"}, "expect": {"id": 6, "ok": true, "result": {"method": "classic"}}},
    {"send": {"id": 7, "type": "helperInfo"}, "expect": {"id": 7, "ok": true, "result": {"sdk": 30, "release": "11", "model": "MiTV-AYFR0", "classicPort": true, "adb": "ready", "method": "classic"}}},
    {"expectAdb": {"ran": [], "paired": []}}
  ]
}

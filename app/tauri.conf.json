{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReTV Bridge",
  "version": "0.1.0",
  "identifier": "app.retv.bridge",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ReTV Bridge",
        "width": 380,
        "height": 520,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "resources/en.lproj/InfoPlist.strings",
        "Resources/ru.lproj/InfoPlist.strings": "resources/ru.lproj/InfoPlist.strings",
        "Resources/uk.lproj/InfoPlist.strings": "resources/uk.lproj/InfoPlist.strings"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["retv-bridge"]
      }
    },
    "updater": {
      "pubkey": "REPLACE_WITH_THE_RETV_BRIDGE_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://retv.app/downloads/retv-bridge.json",
        "https://ru.retv.app/downloads/retv-bridge.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

{
  "profiles": ["bridge", "helper"],
  "description": "A 1.5 MB binary file (every byte value) in chunks of 778240 bytes, each message just under the 1 MiB cap (about 1 037 800 bytes of JSON), arrives byte for byte; nothing is pushed before the last chunk.",
  "adb": {"devices": {"$tvSerial": {"model": "MiTV-AYFR0"}}},
  "steps": [
    {"open": {"origin": "http://127.0.0.1:5180", "host": "$host"}, "expectStatus": 101},
    {"send": {"id": 1, "token": "$token", "type": "connect", "ip": "$tvIp"}, "expect": {"id": 1, "ok": true, "result": {"serial": "$tvSerial", "model": "MiTV-AYFR0"}}},
    {"send": {"id": 2, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/data/local/tmp/retv-home.apk", "offset": 0, "total": 1559040, "data": {"$bytes": {"hex": "", "repeat": 3040}}}, "expect": {"id": 2, "ok": true, "result": {"received": 778240, "done": false}}},
    {"send": {"id": 3, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/data/local/tmp/retv-home.apk", "offset": 778240, "total": 1559040, "data": {"$bytes": {"hex": "", "repeat": 3040}}}, "expect": {"id": 3, "ok": true, "result": {"received": 1556480, "done": false}}},
    {"expectAdb": {"pushed": {}}},
    {"send": {"id": 4, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/data/local/tmp/retv-home.apk", "offset": 1556480, "total": 1559040, "data": {"$bytes": {"hex": "", "repeat": 10}}}, "expect": {"id": 4, "ok": true, "result": {"received": 1559040, "done": true}}},
    {"expectAdb": {"pushed": {"/data/local/tmp/retv-home.apk": "sha256:8f22cb12d662e38a7c5601b64300c3ff3bab3f410d7b508f8bc47593bb175308"}}}
  ]
}

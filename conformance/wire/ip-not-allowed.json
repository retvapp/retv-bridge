{
  "profiles": ["bridge"],
  "description": "connect and pair accept only dotted IPv4 in 10/8, 172.16/12, 192.168/16 and 169.254/16; anything else is ip-not-allowed and never reaches adb.",
  "adb": {"devices": {"192.168.1.5:5555": {"model": "MiTV-AYFR0"}}},
  "steps": [
    {"open": {"origin": "http://127.0.0.1:5180", "host": "$host"}, "expectStatus": 101},
    {"send": {"id": 1, "token": "$token", "type": "connect", "ip": "127.0.0.1", "port": 5555}, "expect": {"id": 1, "ok": false, "error": "ip-not-allowed"}},
    {"send": {"id": 2, "token": "$token", "type": "connect", "ip": "8.8.8.8", "port": 5555}, "expect": {"id": 2, "ok": false, "error": "ip-not-allowed"}},
    {"send": {"id": 3, "token": "$token", "type": "connect", "ip": "192.168.1", "port": 5555}, "expect": {"id": 3, "ok": false, "error": "ip-not-allowed"}},
    {"send": {"id": 4, "token": "$token", "type": "connect", "ip": "192.168.1.5; rm -rf /", "port": 5555}, "expect": {"id": 4, "ok": false, "error": "ip-not-allowed"}},
    {"send": {"id": 5, "token": "$token", "type": "connect", "ip": "172.32.0.1", "port": 5555}, "expect": {"id": 5, "ok": false, "error": "ip-not-allowed"}},
    {"send": {"id": 6, "token": "$token", "type": "connect", "ip": "localhost", "port": 5555}, "expect": {"id": 6, "ok": false, "error": "ip-not-allowed"}},
    {"send": {"id": 7, "token": "$token", "type": "connect", "port": 5555}, "expect": {"id": 7, "ok": false, "error": "ip-not-allowed"}},
    {"send": {"id": 8, "token": "$token", "type": "connect", "ip": "8.8.8.8", "port": 0}, "expect": {"id": 8, "ok": false, "error": "ip-not-allowed"}},
    {"send": {"id": 9, "token": "$token", "type": "pair", "ip": "8.8.8.8", "port": 37215, "code": "123456"}, "expect": {"id": 9, "ok": false, "error": "ip-not-allowed"}},
    {"send": {"id": 10, "token": "$token", "type": "pair", "ip": "127.0.0.1", "port": 37215, "code": "123456"}, "expect": {"id": 10, "ok": false, "error": "ip-not-allowed"}},
    {"expectAdb": {"connected": [], "paired": [], "ran": []}}
  ]
}

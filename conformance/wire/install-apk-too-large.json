{
  "profiles": ["bridge", "helper"],
  "description": "installApk: a download over 64 MiB (67 108 864 bytes) is too-large and never reaches the TV; exactly 64 MiB is still accepted (here it then fails the SHA-256 check).",
  "adb": {
    "devices": {
      "$tvSerial": {
        "model": "MiTV-AYFR0"
      }
    },
    "http": {
      "https://retv.app/downloads/big.apk": {
        "status": 200,
        "bodyHex": "00",
        "repeat": 67108865
      },
      "https://retv.app/downloads/limit.apk": {
        "status": 200,
        "bodyHex": "00",
        "repeat": 67108864
      }
    }
  },
  "steps": [
    {"open":{"origin":"https://retv.app","host":"$host"},"expectStatus":101},
    {"send":{"id":1,"token":"$token","type":"connect","ip":"$tvIp"},"expect":{"id":1,"ok":true,"result":{"serial":"$tvSerial","model":"MiTV-AYFR0"}}},
    {"send":{"id":2,"token":"$token","type":"installApk","serial":"$tvSerial","url":"https://retv.app/downloads/big.apk","sha256":"5702eec1ac8168696925fa05d9c3c0d9cc46153618daebfdad8a551907968dea"},"expect":{"id":2,"ok":false,"error":"too-large"}},
    {"send":{"id":3,"token":"$token","type":"installApk","serial":"$tvSerial","url":"https://retv.app/downloads/limit.apk","sha256":"5702eec1ac8168696925fa05d9c3c0d9cc46153618daebfdad8a551907968dea"},"expect":{"id":3,"ok":false,"error":"sha256-mismatch"}},
    {"expectAdb":{"pushed":{},"ran":[]}}
  ]
}

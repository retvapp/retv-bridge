    {"send": {"id": 20, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/data/local/tmp/retv-home.apk", "offset": 0, "total": 8, "data": "YWJjZA=="}, "expect": {"id": 20, "ok": true, "result": {"received": 4, "done": false}}},
    {"send": {"id": 101, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/data/local/tmp/retv-home.apk", "offset": 4, "total": 8, "data": "not base64!"}, "expect": {"id": 101, "ok": false, "error": "bad-request"}},
    {"send": {"id": 102, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/data/local/tmp/retv-home.apk", "offset": 4, "total": "8", "data": "ZWZnaA=="}, "expect": {"id": 102, "ok": false, "error": "bad-request"}},
    {"send": {"id": 103, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/data/local/tmp/retv-home.apk", "offset": 4, "total": 8, "data": ""}, "expect": {"id": 103, "ok": false, "error": "bad-request"}},
    {"send": {"id": 104, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/system/x", "offset": 4, "total": 8, "data": "ZWZnaA=="}, "expect": {"id": 104, "ok": false, "error": "path-not-allowed"}},
    {"send": {"id": 105, "token": "$token", "type": "writeBytes", "serial": "192.168.1.9:5555", "path": "/data/local/tmp/retv-home.apk", "offset": 4, "total": 8, "data": "ZWZnaA=="}, "expect": {"id": 105, "ok": false, "error": "unknown-serial"}},
    {"send": {"id": 106, "token": "$token", "type": "writeBytes", "serial": "$tvSerial", "path": "/data/local/tmp/retv-home.apk", "offset": 4, "total": 8, "data": "ZWZnaA=="}, "expect": {"id": 106, "ok": true, "result": {"received": 8, "done": true}}},
    {"expectAdb": {"pushed": {

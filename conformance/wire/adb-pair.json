{
  "profiles": ["bridge"],
  "description": "pair is adb pairing with the TV (the 6 digits on the TV screen), not site pairing: it needs the token, a LAN ip, a port and exactly 6 digits.",
  "adb": {"pairCode": "123456"},
  "steps": [
    {"open": {"origin": "http://127.0.0.1:5180", "host": "$host"}, "expectStatus": 101},
    {"send": {"id": 1, "token": "$token", "type": "pair", "ip": "192.168.1.5", "port": 37215, "code": "123456"}, "expect": {"id": 1, "ok": true, "result": {}}},
    {"send": {"id": 2, "token": "$token", "type": "pair", "ip": "192.168.1.5", "port": 37215, "code": "000000"}, "expect": {"id": 2, "ok": false, "error": "pairing-failed"}},
    {"send": {"id": 3, "token": "$token", "type": "pair", "ip": "192.168.1.5", "port": 37215, "code": "12345a"}, "expect": {"id": 3, "ok": false, "error": "bad-request"}},
    {"send": {"id": 4, "token": "$token", "type": "pair", "ip": "192.168.1.5", "port": 37215, "code": "1234567"}, "expect": {"id": 4, "ok": false, "error": "bad-request"}},
    {"send": {"id": 5, "token": "$token", "type": "pair", "ip": "192.168.1.5", "port": 37215, "code": 123456}, "expect": {"id": 5, "ok": false, "error": "bad-request"}},
    {"send": {"id": 6, "token": "$token", "type": "pair", "ip": "192.168.1.5", "code": "123456"}, "expect": {"id": 6, "ok": false, "error": "bad-request"}},
    {"send": {"id": 7, "token": "$token", "type": "pair", "ip": "192.168.1.5", "port": 70000, "code": "123456"}, "expect": {"id": 7, "ok": false, "error": "bad-request"}},
    {"send": {"id": 8, "token": "$token", "type": "pair", "ip": "10.1.2.3", "port": 40111, "code": "123456"}, "expect": {"id": 8, "ok": true, "result": {}}},
    {"expectAdb": {"paired": ["192.168.1.5:37215", "10.1.2.3:40111"], "connected": []}},
    {"send": {"id": 9, "type": "pair", "ip": "192.168.1.5", "port": 37215, "code": "123456"}, "expect": {"id": 9, "ok": false, "error": "bad-token"}},
    {"expectClose": true, "closeCode": 1008}
  ]
}
